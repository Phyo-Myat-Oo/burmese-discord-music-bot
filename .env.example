DISCORD_TOKEN=paste_your_bot_token_here
DISCORD_GUILD_ID=
MUSIC_ADMIN_ROLE=DJ
# Optional: only needed when FFmpeg is not discoverable automatically.
FFMPEG_PATH=
# Seconds of in-memory audio held before Discord playback. Set 0 to disable.
AUDIO_PREBUFFER_SECONDS=2
SYNC_INTERVAL_HOURS=6
# Directory for pre-downloaded audio files (created automatically). Default: data/audio_cache
AUDIO_CACHE_DIR=data/audio_cache
