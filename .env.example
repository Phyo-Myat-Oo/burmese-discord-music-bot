# Required Discord configuration
DISCORD_TOKEN=
CLIENT_ID=

# Recommended for fast slash-command registration during development
GUILD_ID=

# Daisy catalogue and runtime storage
CATALOG_DB_PATH=./data/daisy_v2/catalog.db
STATE_DB_PATH=./data/daisy_state.db
CACHE_DIR=./audio_cache
FFMPEG_PATH=

# Optional music integrations
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Daisy appearance
EMBED_COLOR=#FFCC66
STATUS=Daisy | /youtube play
SUPPORT_SERVER=
WEBSITE=

# Optional YouTube authentication. Never commit cookies.txt.
COOKIES_FROM_BROWSER=
COOKIES_FILE=
YOUTUBE_PO_TOKEN=

# Sharding is unnecessary for a small private bot.
TOTAL_SHARDS=auto
SHARD_LIST=auto
SHARD_MODE=process
SHARD_RESPAWN=true
SHARD_SPAWN_DELAY=5500
SHARD_SPAWN_TIMEOUT=30000
