# Copy to .env and keep all real values private.
DISCORD_TOKEN=put-your-discord-bot-token-here
DISCORD_GUILD_ID=put-your-test-server-id-here
MUSIC_ADMIN_ROLE=DJ
FFMPEG_PATH=

# V2 keeps imported public catalogue data, private user state, and temporary
# audio cache separate from the legacy bot database.
DAISY_V2_DATA_DIR=data/daisy_v2
DAISY_V2_CATALOG_DB=data/daisy_v2/catalog.db
DAISY_V2_STATE_DB=data/daisy_v2/state.db
DAISY_V2_CACHE_DIR=data/daisy_v2/cache

# Cache-first playback: a song is completely downloaded and checked before it
# starts. Files are bounded and automatically evicted; they are not a library.
CACHE_MAX_MB=350
CACHE_MAX_TRACK_MB=120
CACHE_TTL_HOURS=24
PREFETCH_TRACKS=1
PLAYBACK_IDLE_SECONDS=300
SYNC_INTERVAL_HOURS=6

# Optional: only set this when a specific YouTube video requires authentication.
# Invalid/stale cookies can hide audio formats. Never commit this file.
YOUTUBE_COOKIES_FILE=
